# Example .env for ArtStore
# Copy to .env and fill values before deployment

MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/artstore?retryWrites=true&w=majority
PORT=2026
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=rzp_test_secret_xxx

# In production set NODE_ENV=production
