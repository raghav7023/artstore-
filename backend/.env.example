# ==========================================
# Artstore Backend Environment Configuration
# ==========================================
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file with secrets to Git.

# MongoDB Connection String (Atlas or Local)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/artstore?retryWrites=true&w=majority

# Server Port (Default: 2026)
PORT=2026

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# Razorpay Online Payment Gateway (from dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# -------------------------------------------------------------
# Transactional Email Configuration (Resend - Primary)
# -------------------------------------------------------------
# 1. RESEND_API_KEY: Generated in Resend Dashboard (https://resend.com/api-keys)
# 2. RESEND_FROM: Sender email using your verified domain in Resend (https://resend.com/domains)
#    Example: "Art Store <orders@artstorestudio.com>"
# 3. ORDER_NOTIFICATION_EMAIL: Admin inbox where new order notifications are delivered
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM="Art Store <orders@artstorestudio.com>"
ORDER_NOTIFICATION_EMAIL=owner@artstorestudio.com

# -------------------------------------------------------------
# SMTP Fallback Configuration (Nodemailer - Secondary)
# -------------------------------------------------------------
# Used as fallback if Resend is not configured or in local development.
# On cloud hosting (e.g. Render Free), SMTP ports 465/587 are blocked; Resend is required.
EMAIL_USER=your_store_email@gmail.com
EMAIL_PASSWORD=your_16_digit_gmail_app_password

# -------------------------------------------------------------
# Optional WhatsApp Notifications (Meta Cloud API)
# -------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_TO_NUMBER=919999999999
WHATSAPP_API_VERSION=v19.0

# -------------------------------------------------------------
# Security & Deployment
# -------------------------------------------------------------
CLIENT_URL=https://www.artstorestudio.com
NODE_ENV=development
